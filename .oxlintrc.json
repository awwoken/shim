{
  "$schema": "node_modules/oxlint/configuration_schema.json",
  "env": {
    "builtin": true,
    "node": true
  },
  "plugins": ["import", "typescript"],
  "rules": {
    // JavaScript correctness
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "eslint/block-scoped-var": "error",
    "eslint/no-constant-condition": "error",
    "eslint/no-empty": "warn",
    "eslint/no-eq-null": "error",
    "eslint/no-extend-native": "error",
    "eslint/no-redeclare": "error",
    "eslint/no-self-compare": "error",
    "eslint/no-shadow": "error",
    "eslint/no-unreachable": "error",
    "eslint/no-use-before-define": "error",
    "eslint/no-useless-concat": "error",
    "eslint/no-useless-constructor": "error",
    "eslint/preserve-caught-error": [
      "error",
      {
        "requireCatchParameter": true
      }
    ],

    // JavaScript style
    "eslint/curly": "error",
    "eslint/func-style": ["error", "expression"],
    "eslint/grouped-accessor-pairs": "error",
    "eslint/no-else-return": "error",
    "eslint/no-implicit-coercion": "error",
    "eslint/no-lonely-if": "error",
    "eslint/no-magic-numbers": "warn",
    "eslint/no-negated-condition": "warn",
    "eslint/no-nested-ternary": "error",
    "eslint/no-unneeded-ternary": "error",
    "eslint/no-var": "error",
    "eslint/prefer-const": "error",
    "eslint/prefer-destructuring": "error",
    "eslint/yoda": "error",

    // Imports and modules
    "eslint/no-duplicate-imports": "error",
    "import/first": "error",
    "import/max-dependencies": [
      "error",
      {
        "max": 15,
        "ignoreTypeImports": true
      }
    ],
    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "import/no-empty-named-blocks": "warn",
    "import/no-self-import": "warn",

    // TypeScript safety
    "typescript/no-deprecated": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/only-throw-error": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/strict-void-return": "error",

    // TypeScript style
    "typescript/class-literal-property-style": "error",
    "typescript/consistent-type-assertions": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/consistent-type-imports": [
      "error",
      {
        "fixStyle": "inline-type-imports",
        "prefer": "type-imports"
      }
    ],
    "typescript/explicit-function-return-type": "error",
    "typescript/no-import-type-side-effects": "warn",
    "typescript/no-inferrable-types": "error",
    "typescript/no-mixed-enums": "warn",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/no-unnecessary-template-expression": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unnecessary-type-conversion": "error",
    "typescript/non-nullable-type-assertion-style": "warn",
    "typescript/prefer-enum-initializers": "error",
    "typescript/prefer-includes": "warn",
    "typescript/prefer-optional-chain": "warn",
    "typescript/prefer-ts-expect-error": "error",
    "typescript/require-await": "error",
    "typescript/return-await": ["error", "always"],

    // Promises and async
    "promise/no-multiple-resolved": "error",
    "promise/no-promise-in-callback": "warn",
    "promise/param-names": "error",

    // Unicorn and OXC
    "oxc/branches-sharing-code": "warn",
    "oxc/misrefactored-assign-op": "warn",
    "unicorn/catch-error-name": "error",
    "unicorn/consistent-date-clone": "error",
    "unicorn/consistent-existence-index-check": "error",
    "unicorn/explicit-length-check": "error",
    "unicorn/new-for-builtins": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "unicorn/no-array-sort": "error",
    "unicorn/no-empty-file": "error",
    "unicorn/no-instanceof-builtins": "error",
    "unicorn/no-negation-in-equality-check": "error",
    "unicorn/no-useless-undefined": "warn",
    "unicorn/prefer-array-flat-map": "warn",
    "unicorn/prefer-array-some": "error",
    "unicorn/prefer-logical-operator-over-ternary": "error",
    "unicorn/prefer-math-min-max": "warn",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-set-has": "warn",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-ternary": "error",
    "unicorn/require-number-to-fixed-digits-argument": "warn",

    // Size and complexity
    "eslint/complexity": [
      "error",
      {
        "max": 15
      }
    ],
    "eslint/max-lines": [
      "error",
      {
        "max": 300
      }
    ],
    "max-params": "error",

    // Comments and disables
    "eslint/capitalized-comments": "error",

    // Project policy
    "eslint/no-console": "error",
    "eslint/no-restricted-imports": "error",
    "node/no-process-env": "error"
  },
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": ["build", "dist", "node_modules"]
}
